# ==========================================
# ClipForge AI - Configuración de Entorno
# ==========================================

# 1. API Keys de Inteligencia Artificial (Obtén cualquiera de las dos gratis)
# Groq (Recomendada para Whisper ultrarrápido): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (Para análisis viral profundo): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Rendimiento y Memoria
# Mantén en 'true' para servidores con poca RAM como Render Free (512MB)
LOW_MEMORY_MODE=true
DEFAULT_RESOLUTION=720x1280

# 3. Cloudflare R2 Storage (Opcional - Si no se configura, los clips se sirven directo desde el servidor)
# https://dash.cloudflare.com/ (10 GB gratis)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
